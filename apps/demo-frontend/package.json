{
  "name": "@asap-hub/demo-frontend",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "cross-env TSC_COMPILE_ON_ERROR=true vite",
    "build": "vite build",
    "typecheck": "tsc",
    "test": "WORKSPACE_PATH=apps/demo-frontend yarn workspace asap-hub test:workspace",

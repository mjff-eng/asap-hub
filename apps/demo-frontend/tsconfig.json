{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,

    "emitDeclarationOnly": false,
    "noEmit": true,
    "target": "ESNext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "@testing-library/jest-dom"],
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@asap-hub/react-components/src/*": [
        "../../packages/react-components/src/*"
      ],
      "@asap-hub/demo-timeline": ["../../packages/demo-timeline/src"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/react-components" },
    { "path": "../../packages/demo-timeline" }
  ]
}

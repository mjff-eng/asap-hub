{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "emitDeclarationOnly": false,
    "noEmit": true,

    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "baseUrl": ".",

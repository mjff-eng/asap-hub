exports[`buildRenderPlan a narration take mixes the take into the join in programme time 1`] = `
{
  "args": [
    "-nostdin",
    "-y",
    "-copyts",
    "-f",
    "concat",
    "-safe",
    "0",
    "-i",
    "/work/concat.txt",
    "-i",
    "/work/clip-0.mp4",
    "-i",
    "/media/voice-1.m4a",
    "-filter_complex",
    "[1:a]concat=n=1:v=0:a=1[pa];[2:a]atrim=0.000:4.000,asetpts=PTS-STARTPTS,volume=0.8,aformat=sample_fmts=fltp:sample_rates=48000:channel_layouts=stereo,adelay=1500:all=1[n0];[pa][n0]amix=inputs=2:normalize=0:dropout_transition=0,apad,atrim=0:10.000[a]",
    "-map",
    "0:v",
    "-map",
    "[a]",
    "-c:v",
    "copy",
    "-c:a",
    "aac",
    "-b:a",
    "128k",
    "-movflags",
    "+faststart",
    "/work/out.mp4",
  ],
  "label": "join 1 clip (concat)",
  "output": "/work/out.mp4",
  "serial": true,
  "weightMs": 10000,
}
`;


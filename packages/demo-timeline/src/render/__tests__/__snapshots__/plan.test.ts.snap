      "-map",
      "[v1]",
      "-map",
      "0:a?",
      "-fps_mode",
      "cfr",
      "-r",
      "30",
      "-c:v",
      "libx264",
      "-preset",
      "veryfast",
      "-crf",
      "20",
      "-g",
      "60",
      "-keyint_min",
      "60",
      "-sc_threshold",
      "0",
      "-pix_fmt",
      "yuv420p",
      "-c:a",
      "aac",
      "-b:a",
      "128k",
      "-af",
      "aresample=async=1:first_pts=0,aformat=sample_fmts=fltp:sample_rates=48000:channel_layouts=stereo,apad=whole_dur=10.000",
      "-movflags",
      "+faststart",
      "/work/clip-0.mp4",
    ],
    "label": "clip 0 (source asset-1)",
    "output": "/work/clip-0.mp4",
    "weightMs": 10000,
  },
  {
    "args": [
      "-nostdin",
      "-y",
      "-copyts",
      "-f",
      "concat",
      "-safe",
      "0",
      "-i",
      "/work/concat.txt",
      "-i",
      "/work/clip-0.mp4",
      "-filter_complex",
      "[1:a]concat=n=1:v=0:a=1[pa]",
      "-map",
      "0:v",
      "-map",
      "[pa]",
      "-c:v",
      "copy",
